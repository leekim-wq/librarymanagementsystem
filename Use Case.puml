@startuml
left to right direction
actor Admin
actor Librarian
actor Member

rectangle "Library Management System" {
  usecase "Manage Books" as UC1
  usecase "Manage Users" as UC2
  usecase "Browse Books" as UC3
  usecase "Search Books" as UC4
  usecase "Add to Cart / Checkout" as UC5
  usecase "View Loans" as UC6
  usecase "Return Book" as UC7
  usecase "AI Recommendations" as UC8
}

Admin --> UC1
Admin --> UC2
Admin --> UC7
Librarian --> UC1
Librarian --> UC7
Member --> UC3
Member --> UC4
Member --> UC5
Member --> UC6
Member --> UC8
@enduml