@startuml
package "Web Browser" {
  [HTML/CSS/JS] as UI
}

package "Spring Boot Application" {
  [Presentation Layer] as PL
  [Business Layer] as BL
  [Data Access Layer] as DAL
}

database "MySQL" as DB
node "AI Microservice" as AI

UI --> PL : HTTP Requests
PL --> BL : Service Calls
BL --> DAL : Repository Calls
DAL --> DB : SQL
BL --> AI : REST Calls (recommendations)
@enduml